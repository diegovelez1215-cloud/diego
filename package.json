    "serve:foundation": "node scripts/serve-v2-foundation.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
