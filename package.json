{
  "name": "united-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "test:logic": "node --test \"tests/*.test.mjs\"",
    "test:ui": "playwright test",
    "test:release": "npm run test:logic && npm run test:ui",
    "dev:v2": "vite --config vite.config.ts",
    "build:v2": "vite build --config vite.config.ts",
    "typecheck:v2": "tsc --project tsconfig.v2.json --noEmit",
